# Copy this file to `.env` and fill in the values. `.env` is git-ignored —
# never commit real keys. In production, set the same variables in your host's
# dashboard (Vercel/Netlify -> Settings -> Environment Variables).

# Required for the chatbot. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: get every chat conversation by email.
# API key from https://resend.com (free tier). Leave empty to disable.
RESEND_API_KEY=
# Where to send them — with the shared sender below this must be the address
# your Resend account is registered with.
NOTIFY_EMAIL=rivky.grinberg@gmail.com
# Only change once you've verified your own domain in Resend.
NOTIFY_FROM=Portfolio bot <onboarding@resend.dev>
